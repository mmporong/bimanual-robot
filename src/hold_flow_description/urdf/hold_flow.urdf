    <parent link="right_gripper_base_link"/>
    <child link="right_finger2_link"/>
    <origin rpy="0 0 0" xyz="0 -0.010 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="40" lower="0.01" upper="0.0433" velocity="0.05"/>
    <dynamics damping="0.50" friction="0.10"/>
    <safety_controller k_position="30" k_velocity="3" soft_lower_limit="0.011" soft_upper_limit="0.0423"/>
    <mimic joint="right_finger1_joint" multiplier="1.0" offset="0.0"/>
  </joint>
  <link name="right_finger2_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.006 -0.030 0"/>
      <mass value="0.027"/>
      <inertia ixx="1.6e-05" ixy="0" ixz="0" iyy="6.0e-06" iyz="0" izz="1.5e-05"/>
    </inertial>
    <!-- 랙 -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.028 0.004 0"/>
      <geometry>
        <box size="0.058 0.010 0.026"/>
      </geometry>
      <material name="ggao50_printed"/>
    </visual>
    <!-- 손가락 블레이드. 끝으로 갈수록 접촉 높이가 57.5 에서 8.8 mm 로 줄어든다. -->
    <visual>
      <origin rpy="0 0 0" xyz="0.006 -0.030 0"/>
      <geometry>
        <box size="0.012 0.060 0.050"/>
      </geometry>
      <material name="ggao50_printed"/>
    </visual>
    <!-- 교체형 인서트. 135도 V홈 기준 두께 12.2 mm -->
    <visual>
      <origin rpy="0 0 0" xyz="-0.0061 -0.030 0"/>
      <geometry>
        <box size="0.0122 0.060 0.050"/>
      </geometry>
      <material name="gripper_insert"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.002 -0.024 0"/>
      <geometry>
        <box size="0.031 0.072 0.050"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_tool0_joint" type="fixed">
    <parent link="right_gripper_base_link"/>
    <child link="right_tool0"/>
    <origin rpy="0 0 0" xyz="0 -0.04 0"/>
  </joint>
  <!-- 두 죠 사이 중앙의 파지 기준. IK 목표와 FK 대조는 이 프레임을 쓴다. -->
  <link name="right_tool0"/>
  <joint name="right_bottle_tcp_joint" type="fixed">
    <parent link="right_tool0"/>
    <child link="right_bottle_tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0.09"/>
  </joint>
  <link name="right_bottle_tcp"/>
  <joint name="right_cup_tcp_joint" type="fixed">
    <parent link="right_tool0"/>
    <child link="right_cup_tcp"/>
    <origin rpy="0 0 0" xyz="0 0 0.04"/>
  </joint>
  <link name="right_cup_tcp"/>
</robot>
