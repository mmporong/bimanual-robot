<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hold_flow_sensors">
    <!-- 20×20×240 mm 후방 중앙 마스트. 8 mm 보강판 위 z=728 mm에서 시작한다. -->
    <link name="camera_mast_link">
      <xacro:box_inertial mass="0.044" x="0.020" y="0.020" z="0.240"/>
      <visual>
        <geometry><mesh filename="package://hold_flow_description/meshes/cad/camera_mast_segment.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="hold_flow_dark"/>
      </visual>
      <collision><origin xyz="0 0 0.120"/><geometry><box size="0.020 0.020 0.240"/></geometry></collision>
    </link>
    <joint name="camera_mast_joint" type="fixed">
      <parent link="base_link"/><child link="camera_mast_link"/>
      <origin xyz="-0.120 0 0.6951" rpy="0 0 0"/>
    </joint>

    <link name="camera_link">
      <inertial>
        <mass value="0.310"/>
        <inertia ixx="0.00076283" ixy="0" ixz="0" iyy="0.00010085" iyz="0" izz="0.00074465"/>
      </inertial>
      <!-- Astra S: +X 깊이, +Y 폭, +Z 높이. 본체 프레임은 질량중심 근사다. -->
      <visual><geometry><box size="0.040 0.165 0.048"/></geometry><material name="hold_flow_blue"/></visual>
      <collision><geometry><box size="0.040 0.165 0.048"/></geometry></collision>
    </link>
    <joint name="camera_mount_joint" type="fixed">
      <parent link="camera_mast_link"/><child link="camera_link"/>
      <!-- 광학 중심 (-110,0,970) mm를 만들도록 35도 하향 자세에서 역산한 본체 중심. -->
      <origin xyz="-0.006383 0 0.253472" rpy="0 0.6108652382 0"/>
    </joint>

    <link name="camera_cradle_link">
      <xacro:box_inertial mass="0.085" x="0.065" y="0.182" z="0.030"/>
      <visual><geometry><mesh filename="package://hold_flow_description/meshes/cad/astra_cradle.stl" scale="0.001 0.001 0.001"/></geometry><material name="hold_flow_dark"/></visual>
      <collision><origin xyz="0 0 0.015"/><geometry><box size="0.065 0.182 0.030"/></geometry></collision>
    </link>
    <joint name="camera_cradle_joint" type="fixed">
      <parent link="camera_link"/><child link="camera_cradle_link"/>
      <origin xyz="0 0 -0.030" rpy="0 0 0"/>
    </joint>

    <!-- Astra 계열 optical convention: +Z forward, +X right, +Y down. -->
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/><child link="camera_depth_optical_frame"/>
      <origin xyz="0.020 0 0" rpy="-1.5707963268 0 -1.5707963268"/>
    </joint>
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_depth_optical_frame"/><child link="camera_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="laser_link">
      <inertial>
        <mass value="0.042"/>
        <inertia ixx="9e-6" ixy="0" ixz="0" iyy="9e-6" iyz="0" izz="1.6e-5"/>
      </inertial>
      <visual><geometry><cylinder radius="0.02735" length="0.034"/></geometry><material name="hold_flow_blue"/></visual>
      <collision><geometry><cylinder radius="0.02735" length="0.034"/></geometry></collision>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/><child link="laser_link"/>
      <origin xyz="0.100 0 0.1321" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
