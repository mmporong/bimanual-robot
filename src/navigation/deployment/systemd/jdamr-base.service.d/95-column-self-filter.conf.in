[Service]
ExecStart=
ExecStart=/bin/bash -c "set +u; source /opt/ros/jazzy/setup.bash; source @JDAMR_WS@/install/setup.bash; exec ros2 launch jdamr_cube_navigation real_bringup_imu.launch.py wheel_radius:=0.0329 wheel_separation:=0.510 discovery_range:=LOCALHOST scan_self_filter_config:=@DEPLOY_DIR@/self_filter_columns_20261012.yaml"
