<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 ${z / 2.0}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x * x + z * z) / 12.0}" iyz="0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + width * width) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * radius * radius / 2.0}" iyz="0"
        izz="${mass * (3.0 * radius * radius + width * width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="primitive_box_link" params="name parent xyz mass sx sy sz material">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (sy * sy + sz * sz) / 12.0}" ixy="0" ixz="0"
          iyy="${mass * (sx * sx + sz * sz) / 12.0}" iyz="0"
          izz="${mass * (sx * sx + sy * sy) / 12.0}"/>
      </inertial>
      <visual><geometry><box size="${sx} ${sy} ${sz}"/></geometry><material name="${material}"/></visual>
      <collision><geometry><box size="${sx} ${sy} ${sz}"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}"/><origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- 시각은 설계 STL, 충돌은 Isaac Sim 접촉 안정성을 위한 보수적 볼록 박스다. -->
  <xacro:macro name="cad_mesh_link" params="name parent xyz mesh mass sx sy sz material">
    <link name="${name}">
      <xacro:box_inertial mass="${mass}" x="${sx}" y="${sy}" z="${sz}"/>
      <visual>
        <geometry>
          <mesh filename="package://hold_flow_description/meshes/cad/${mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${sz / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="hold_flow_mobile_base">
    <!-- 모델 원점은 차체 중심이다. 실차 전륜축 원점과의 변환은 mechanical_calibration.yaml에 둔다. -->
    <xacro:property name="drive_config" value="${xacro.load_yaml('../config/mechanical_calibration.yaml')['drive']}"/>
    <link name="base_footprint"/>
    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0.030" rpy="0 0 0"/>
        <mass value="0.250"/>
        <inertia ixx="0.001602" ixy="0" ixz="0" iyy="0.001602" iyz="0" izz="0.002604"/>
      </inertial>
    </link>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.0329" rpy="0 0 0"/>
    </joint>

    <!-- 하부와 상부는 같은 340(x)×450(y) mm 2020 프로파일 외곽이다. -->
    <xacro:primitive_box_link name="lower_front_rail_link" parent="base_link" xyz="0.160 0 0.0171" mass="0.216" sx="0.020" sy="0.450" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="lower_rear_rail_link" parent="base_link" xyz="-0.160 0 0.0171" mass="0.216" sx="0.020" sy="0.450" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="lower_left_rail_link" parent="base_link" xyz="0 0.215 0.0171" mass="0.144" sx="0.300" sy="0.020" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="lower_right_rail_link" parent="base_link" xyz="0 -0.215 0.0171" mass="0.144" sx="0.300" sy="0.020" sz="0.020" material="silver"/>

    <xacro:primitive_box_link name="upper_front_rail_link" parent="base_link" xyz="0.160 0 0.6711" mass="0.216" sx="0.020" sy="0.450" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="upper_rear_rail_link" parent="base_link" xyz="-0.160 0 0.6711" mass="0.216" sx="0.020" sy="0.450" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="upper_left_rail_link" parent="base_link" xyz="0 0.215 0.6711" mass="0.144" sx="0.300" sy="0.020" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="upper_right_rail_link" parent="base_link" xyz="0 -0.215 0.6711" mass="0.144" sx="0.300" sy="0.020" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="upper_x_seam_support_link" parent="base_link" xyz="-0.050 0 0.6711" mass="0.216" sx="0.020" sy="0.450" sz="0.020" material="silver"/>
    <xacro:primitive_box_link name="upper_y_seam_support_link" parent="base_link" xyz="0 0 0.6711" mass="0.144" sx="0.300" sy="0.020" sz="0.020" material="silver"/>

    <xacro:cad_mesh_link name="tabletop_front_left_link" parent="base_link" xyz="0.06015 0.11265 0.6811" mesh="tabletop_front_left.stl" mass="0.170" sx="0.2197" sy="0.2247" sz="0.006" material="hold_flow_white"/>
    <xacro:cad_mesh_link name="tabletop_front_right_link" parent="base_link" xyz="0.06015 -0.11265 0.6811" mesh="tabletop_front_right.stl" mass="0.170" sx="0.2197" sy="0.2247" sz="0.006" material="hold_flow_white"/>
    <xacro:cad_mesh_link name="tabletop_rear_left_link" parent="base_link" xyz="-0.11015 0.11265 0.6811" mesh="tabletop_rear_left.stl" mass="0.170" sx="0.1197" sy="0.2247" sz="0.006" material="hold_flow_white"/>
    <xacro:cad_mesh_link name="tabletop_rear_right_link" parent="base_link" xyz="-0.11015 -0.11265 0.6811" mesh="tabletop_rear_right.stl" mass="0.170" sx="0.1197" sy="0.2247" sz="0.006" material="hold_flow_white"/>

    <xacro:cad_mesh_link name="front_left_frame_column_link" parent="base_link" xyz="0.150 0.205 0.0271" mesh="frame_column.stl" mass="0.304" sx="0.020" sy="0.020" sz="0.634" material="silver"/>
    <xacro:cad_mesh_link name="front_right_frame_column_link" parent="base_link" xyz="0.150 -0.205 0.0271" mesh="frame_column.stl" mass="0.304" sx="0.020" sy="0.020" sz="0.634" material="silver"/>
    <xacro:cad_mesh_link name="rear_left_frame_column_link" parent="base_link" xyz="-0.150 0.205 0.0271" mesh="frame_column.stl" mass="0.304" sx="0.020" sy="0.020" sz="0.634" material="silver"/>
    <xacro:cad_mesh_link name="rear_right_frame_column_link" parent="base_link" xyz="-0.150 -0.205 0.0271" mesh="frame_column.stl" mass="0.304" sx="0.020" sy="0.020" sz="0.634" material="silver"/>

    <xacro:cad_mesh_link name="left_arm_backing_link" parent="base_link" xyz="0.020 0.170 0.6871" mesh="arm_adapter.stl" mass="0.058" sx="0.130" sy="0.070" sz="0.006" material="hold_flow_dark"/>
    <xacro:cad_mesh_link name="right_arm_backing_link" parent="base_link" xyz="0.020 -0.170 0.6871" mesh="arm_adapter.stl" mass="0.058" sx="0.130" sy="0.070" sz="0.006" material="hold_flow_dark"/>
    <xacro:cad_mesh_link name="camera_backing_link" parent="base_link" xyz="-0.120 0 0.6871" mesh="camera_backing.stl" mass="0.030" sx="0.055" sy="0.055" sz="0.008" material="hold_flow_dark"/>
    <xacro:cad_mesh_link name="battery_mount_plate_link" parent="base_link" xyz="-0.040 0 0.0351" mesh="battery_mount_plate.stl" mass="0.120" sx="0.180" sy="0.120" sz="0.006" material="hold_flow_blue"/>
    <xacro:cad_mesh_link name="lidar_mount_plate_link" parent="base_link" xyz="0.100 0 0.1121" mesh="lidar_mount_plate.stl" mass="0.035" sx="0.090" sy="0.075" sz="0.003" material="hold_flow_blue"/>

    <xacro:primitive_box_link name="battery_link" parent="base_link" xyz="-0.040 0 0.0611" mass="0.550" sx="0.140" sy="0.080" sz="0.040" material="hold_flow_blue"/>
    <xacro:primitive_box_link name="electronics_link" parent="base_link" xyz="0.030 0 0.0571" mass="0.350" sx="0.160" sy="0.120" sz="0.040" material="hold_flow_dark"/>

    <xacro:drive_wheel name="left_wheel" x="${drive_config['front_axle_x_m']}" y="${drive_config['geometric_wheel_center_separation_m'] / 2}" config="${drive_config}"/>
    <xacro:drive_wheel name="right_wheel" x="${drive_config['front_axle_x_m']}" y="${-drive_config['geometric_wheel_center_separation_m'] / 2}" config="${drive_config}"/>
    <xacro:drive_wheel name="rear_left_wheel" x="${drive_config['rear_axle_x_m']}" y="${drive_config['geometric_wheel_center_separation_m'] / 2}" config="${drive_config}"/>
    <xacro:drive_wheel name="rear_right_wheel" x="${drive_config['rear_axle_x_m']}" y="${-drive_config['geometric_wheel_center_separation_m'] / 2}" config="${drive_config}"/>
  </xacro:macro>

  <xacro:macro name="drive_wheel" params="name x y config">
    <link name="${name}_link">
      <xacro:wheel_inertial mass="${config['mass_each_kg']}" radius="${config['wheel_radius_m']}" width="${config['visual_width_m']}"/>
      <visual><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="${config['wheel_radius_m']}" length="${config['visual_width_m']}"/></geometry><material name="hold_flow_dark"/></visual>
      <collision><origin rpy="${pi / 2} 0 0"/><geometry><cylinder radius="${config['wheel_radius_m']}" length="${config['visual_width_m']}"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
      <limit effort="${config['joint_effort_nm']}" velocity="${config['joint_velocity_radps']}"/><dynamics damping="0.02" friction="0.02"/>
    </joint>
  </xacro:macro>
</robot>
